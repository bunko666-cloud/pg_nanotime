-- Phase 3: cross-backend strictly increasing clock (needs shared_preload_libraries).
-- Two expected files: global.out (preloaded) and global_1.out (not preloaded).
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pg_nanotime;
RESET client_min_messages;
SELECT preloaded FROM nanotime_clock_status();
 preloaded 
-----------
 t
(1 row)

SELECT clock_ns_global() IS NOT NULL AS works;
 works 
-------
 t
(1 row)

WITH s AS (SELECT g, clock_ns8_global() t FROM generate_series(1, 200000) g),
     d AS (SELECT t, lag(t) OVER (ORDER BY g) p FROM s)
SELECT count(*) AS n, count(*) FILTER (WHERE t <= p) AS not_increasing,
       count(DISTINCT t) AS distinct_values FROM d;
   n    | not_increasing | distinct_values 
--------+----------------+-----------------
 200000 |              0 |          200000
(1 row)

SELECT clock_ns_global() < clock_ns8_global() AND clock_ns8_global() < clock_ns_global() AS shared_counter;
 shared_counter 
----------------
 t
(1 row)

SELECT global_calls > 0 AS counted, global_last_ns IS NOT NULL AS has_last, global_lead_ns < 1000000000 AS lead_small
  FROM nanotime_clock_status();
 counted | has_last | lead_small 
---------+----------+------------
 t       | t        | t
(1 row)

