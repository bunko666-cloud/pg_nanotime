-- integer now is set, so a retention policy runs
SELECT add_retention_policy('s16', drop_after => ns('1 day')) AS job \gset
CALL run_job(:job);
SELECT count(*) AS after_retention FROM s16;
 after_retention 
-----------------
               0
(1 row)

SELECT remove_retention_policy('s16');
